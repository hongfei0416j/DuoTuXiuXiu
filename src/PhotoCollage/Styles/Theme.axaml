<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- ===================== Global ===================== -->
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource BgApp}" />
    <Setter Property="FontFamily" Value="{DynamicResource AppFont}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.h1">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.h2">
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="TextBlock.section">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="TextBlock.muted">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <Style Selector="TextBlock.value">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>

  <Style Selector="TextBlock.tiny">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <!-- ===================== Surfaces ===================== -->
  <Style Selector="Border.panel">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="BoxShadow" Value="0 6 22 0 #10000000" />
  </Style>

  <Style Selector="Border.canvasHost">
    <Setter Property="Background" Value="{DynamicResource BgCanvas}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="18" />
  </Style>

  <Style Selector="Border.sectionCard">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeSoft}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="12" />
  </Style>

  <Style Selector="Border.divider">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource StrokeSoft}" />
  </Style>

  <Style Selector="Border.badge">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="9,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <Style Selector="Border.badge TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="Border.dot">
    <Setter Property="Width" Value="6" />
    <Setter Property="Height" Value="6" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!-- ===================== Buttons ===================== -->
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="34" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="BtnRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}"
                RenderTransformOrigin="0.5,0.5">
          <ContentPresenter Name="BtnContent"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="Button:pointerover /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
  </Style>

  <Style Selector="Button:pressed /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource BgSunken}" />
    <Setter Property="RenderTransform" Value="scale(0.985)" />
  </Style>

  <Style Selector="Button:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="18,9" />
  </Style>

  <Style Selector="Button.primary:pointerover /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource AccentGradientHover}" />
  </Style>

  <Style Selector="Button.primary:pressed /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource AccentGradientHover}" />
    <Setter Property="RenderTransform" Value="scale(0.98)" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontWeight" Value="Normal" />
  </Style>

  <Style Selector="Button.ghost:pointerover /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>

  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.ghost:pressed /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource BgSunken}" />
  </Style>

  <Style Selector="Button.icon">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="13" />
  </Style>

  <Style Selector="Button.icon:pointerover /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="Button.icon:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.bar">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <Style Selector="Button.bar:pointerover /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="Button.bar:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.bar.close:pointerover /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource Danger}" />
  </Style>

  <Style Selector="Button.bar.close:pointerover">
    <Setter Property="Foreground" Value="White" />
  </Style>

  <Style Selector="Button.tiny">
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>

  <Style Selector="Button.link:pointerover /template/ Border#BtnRoot">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Button.link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource AccentDeep}" />
  </Style>

  <Style Selector="Button.layoutCard">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="Width" Value="100" />
    <Setter Property="Height" Value="96" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.layoutCard:pointerover /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
  </Style>

  <Style Selector="Button.layoutCard.selected">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="Button.layoutCard.selected:pointerover /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentDeep}" />
  </Style>

  <Style Selector="Button.swatch">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="BorderBrush" Value="#66000000" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.swatch:pointerover /template/ Border#BtnRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- ===================== Chips / pills / tabs ===================== -->
  <Style Selector="RadioButton.chip">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="ChipRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.chip:pointerover /template/ Border#ChipRoot">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
  </Style>

  <Style Selector="RadioButton.chip:checked /template/ Border#ChipRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
  </Style>

  <Style Selector="RadioButton.chip:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="RadioButton.pill">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="6,0" />
    <Setter Property="MinWidth" Value="34" />
    <Setter Property="Height" Value="30" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Margin" Value="0,0,3,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="ChipRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.pill:pointerover /template/ Border#ChipRoot">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="RadioButton.pill:checked /template/ Border#ChipRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBorder}" />
  </Style>

  <Style Selector="RadioButton.pill:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentDeep}" />
    <Setter Property="FontWeight" Value="Bold" />
  </Style>

  <Style Selector="RadioButton.tab">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="Padding" Value="3,5" />
    <Setter Property="Margin" Value="0,0,14,0" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="TabRoot"
                Background="Transparent"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.tab:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="RadioButton.tab:checked">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="RadioButton.tab:checked /template/ Border#TabRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <!-- segmented switch used for 颜色 / 图片 -->
  <Style Selector="RadioButton.segment">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="0,6" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="SegRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="RadioButton.segment:checked /template/ Border#SegRoot">
    <Setter Property="Background" Value="{DynamicResource BgPanel}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
  </Style>

  <Style Selector="RadioButton.segment:checked">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <!-- aspect lock toggle -->
  <Style Selector="ToggleButton.lockBtn">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="LockRoot"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ToggleButton.lockBtn:pointerover /template/ Border#LockRoot">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="ToggleButton.lockBtn:checked /template/ Border#LockRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <Style Selector="ToggleButton.lockBtn:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentDeep}" />
  </Style>

  <!-- toolbar toggle (fill canvas) -->
  <Style Selector="ToggleButton.bar">
    <Setter Property="Width" Value="38" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="BtnRoot"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Center"
                            VerticalContentAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ToggleButton.bar:pointerover /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="ToggleButton.bar:checked /template/ Border#BtnRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <Style Selector="ToggleButton.bar:checked">
    <Setter Property="Foreground" Value="{DynamicResource AccentDeep}" />
  </Style>

  <!-- ===================== ComboBox ===================== -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <ControlTemplate>
        <Grid ColumnDefinitions="*,Auto">
          <Border Name="ComboRoot"
                  Grid.ColumnSpan="2"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{TemplateBinding CornerRadius}" />
          <ContentControl Name="ContentPresenter"
                          Margin="{TemplateBinding Padding}"
                          Content="{TemplateBinding SelectionBoxItem}"
                          ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                          IsHitTestVisible="False" />
          <Path Grid.Column="1"
                Data="M0 0 L4.2 4.4 L8.4 0"
                Stroke="{DynamicResource TextMuted}"
                StrokeThickness="1.4"
                StrokeLineCap="Round"
                Margin="0,1,10,0"
                VerticalAlignment="Center"
                IsHitTestVisible="False" />
          <Popup Name="PART_Popup"
                 IsOpen="{TemplateBinding IsDropDownOpen}"
                 Placement="Bottom"
                 VerticalOffset="4"
                 IsLightDismissEnabled="True">
            <Border Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource Stroke}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="4"
                    MinWidth="112"
                    MaxHeight="300"
                    BoxShadow="0 12 32 0 #24000000">
              <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsPresenter Name="PART_ItemsPresenter" />
              </ScrollViewer>
            </Border>
          </Popup>
        </Grid>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ComboBox:pointerover /template/ Border#ComboRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
  </Style>

  <Style Selector="ComboBox:focus /template/ Border#ComboRoot">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="ItemRoot"
                Background="{TemplateBinding Background}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            VerticalAlignment="Center" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ComboBoxItem:pointerover /template/ Border#ItemRoot">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="ComboBoxItem:selected /template/ Border#ItemRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
  </Style>

  <!-- ===================== Inputs ===================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource BgSubtle}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Stroke}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="8,6" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentDeep}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoft}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource StrokeStrong}" />
  </Style>

  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="CheckBox">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="22" />
  </Style>

  <Style Selector="ToggleSwitch">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="24" />
  </Style>

  <!-- ===================== Lists ===================== -->
  <Style Selector="ListBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="5" />
    <Setter Property="Margin" Value="0,0,0,6" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="ItemRoot"
                Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                CornerRadius="{TemplateBinding CornerRadius}"
                Padding="{TemplateBinding Padding}">
          <ContentPresenter Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Border>
      </ControlTemplate>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem:pointerover /template/ Border#ItemRoot">
    <Setter Property="Background" Value="{DynamicResource BgHover}" />
  </Style>

  <Style Selector="ListBoxItem:selected /template/ Border#ItemRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
  </Style>

  <Style Selector="ListBoxItem.dragover /template/ Border#ItemRoot">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentDeep}" />
  </Style>

  <Style Selector="ScrollViewer">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="#EE20242E" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="8,5" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

</Styles>
